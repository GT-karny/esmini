# Vendored runtimes: keep binaries that global *.dll/*.exe/*.zip rules would drop (fresh-clone runnability)
!thirdparty/python-embed/**/*.dll
!thirdparty/python-embed/**/*.exe
!thirdparty/python-embed/**/*.zip
!thirdparty/SDL2/**/*.dll

# External specs (large, not needed in git)
thirdparty/opendrive/
thirdparty/openscenario/
thirdparty/openscenario-v1.2.0/
thirdparty/osi-python/

# Claude Code skills (external toolkits)
.claude/skills/skill-creator/

# Machine-local Claude Code settings (not shared across machines)
.claude/settings.local.json

# TypeScript incremental build info (generated, machine-local)
*.tsbuildinfo

# Scratch / exploratory work (not for review)
scratch/

# Scenario authoring: regenerated validation report (not committed)
resources/scenario_authoring/validate_report.md

# ODR conformance fixtures: ASAM-derived content is local-only (never committed)
GT_esmini/test/odr_fixtures/official/
GT_esmini/test/odr_fixtures/schema19/
GT_esmini/test/odr_fixtures/reports/
GT_esmini/test/odr_fixtures/work/
# Claude Code build skill: rescue from the generic build/ pattern above
!.claude/skills/build/
!.claude/skills/build/**

# F7b FFB spike: venv and raw CSVs are local-only (summary JSONs are committed)
scripts/ffb_spike/.venv/
scripts/ffb_spike/logs/*.csv

# Codex harness: skills are a symlink into .claude/skills (absolute path, machine-local).
# The real skill sources live under .claude/skills/ and are committed there.
.codex/skills

# Web UI runtime settings: generated by the backend, holds machine-local absolute
# paths (projects_root). Defaults live in GT_esmini/web/backend/config.py.
GT_esmini/web/settings.json

# Ad-hoc debug dumps from headless/test runs
/debug_*.log
/gttest_*.log

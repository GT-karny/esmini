<?xml version="1.0" ?>
<!--
    Regression pin for the LHT junction OSI-intersection crash.

    Requires all three of: rule="LHT" roads, a junction esmini classifies as an OSI intersection,
    and OSI ground truth actually being requested (GT_Loader --osi). The static ground truth is
    built on the first OSI request, i.e. at t=0 -- before the fix this scenario died there with a
    null dereference in the junction lane-pairing builder, so the scenario was simply unplayable.

    The road (lht_junction_osi_intersection.xodr) carries the trigger: road 1's lane -1 is a
    sidewalk, so the incoming lane the LHT arm of the lane-pairing guard failed to check does not
    exist as a driving lane. See the comment on that lane.
-->
<OpenSCENARIO xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="OpenScenario.xsd">
    <FileHeader description="LHT junction + OSI ground truth regression" author="GT_esmini" revMajor="1" revMinor="0" date="2026-07-13T00:00:00"/>
    <CatalogLocations>
        <VehicleCatalog>
            <Directory path="../../../resources/xosc/Catalogs/Vehicles"/>
        </VehicleCatalog>
    </CatalogLocations>
    <RoadNetwork>
        <LogicFile filepath="lht_junction_osi_intersection.xodr"/>
    </RoadNetwork>
    <Entities>
        <ScenarioObject name="Ego">
            <CatalogReference catalogName="VehicleCatalog" entryName="car_white"/>
        </ScenarioObject>
    </Entities>
    <Storyboard>
        <Init>
            <Actions>
                <Private entityRef="Ego">
                    <PrivateAction>
                        <TeleportAction>
                            <Position>
                                <LanePosition roadId="0" laneId="-1" s="50" offset="0"/>
                            </Position>
                        </TeleportAction>
                    </PrivateAction>
                    <PrivateAction>
                        <LongitudinalAction>
                            <SpeedAction>
                                <SpeedActionDynamics dynamicsShape="step" value="1" dynamicsDimension="time"/>
                                <SpeedActionTarget>
                                    <AbsoluteTargetSpeed value="10"/>
                                </SpeedActionTarget>
                            </SpeedAction>
                        </LongitudinalAction>
                    </PrivateAction>
                </Private>
            </Actions>
        </Init>
        <Story name="story">
            <Act name="act">
                <ManeuverGroup name="empty" maximumExecutionCount="1">
                    <Actors selectTriggeringEntities="false"/>
                </ManeuverGroup>
                <StartTrigger/>
                <StopTrigger/>
            </Act>
        </Story>
        <StopTrigger>
            <ConditionGroup>
                <Condition name="stop" delay="0" conditionEdge="none">
                    <ByValueCondition>
                        <SimulationTimeCondition value="4" rule="greaterThan"/>
                    </ByValueCondition>
                </Condition>
            </ConditionGroup>
        </StopTrigger>
    </Storyboard>
</OpenSCENARIO>

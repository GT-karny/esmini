<?xml version="1.0" ?>
<!--
    Regression pin for the roadMark 4-step null-deref chain in the OSI free-boundary path
    (GT_OSIReporter_Geometry.cpp, resolve_free_boundary / G3).

    Same junction topology as rht_junction_osi_intersection.xosc, but loads
    osi_junction_roadmark_edge.xodr, whose connecting road id=100, driving lane id=-1 carries a
    <roadMark> with a <type> child and NO <line> child. That map is standard conformant OpenDRIVE
    but leaves GetLaneRoadMarkTypeLineByIdx(0) null; before the fix the OSI ground-truth builder
    dereferenced that null at t=0 and crashed. Runs with OSI ground truth requested (GT_Loader
    --osi), which is what builds the junction lane boundaries in the first place.
-->
<OpenSCENARIO xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="OpenScenario.xsd">
    <FileHeader description="OSI junction roadMark edge-case (type without line) regression" author="GT_esmini" revMajor="1" revMinor="0" date="2026-07-13T00:00:00"/>
    <CatalogLocations>
        <VehicleCatalog>
            <Directory path="../../../resources/xosc/Catalogs/Vehicles"/>
        </VehicleCatalog>
    </CatalogLocations>
    <RoadNetwork>
        <LogicFile filepath="osi_junction_roadmark_edge.xodr"/>
    </RoadNetwork>
    <Entities>
        <ScenarioObject name="Ego">
            <CatalogReference catalogName="VehicleCatalog" entryName="car_white"/>
        </ScenarioObject>
    </Entities>
    <Storyboard>
        <Init>
            <Actions>
                <Private entityRef="Ego">
                    <PrivateAction>
                        <TeleportAction>
                            <Position>
                                <LanePosition roadId="0" laneId="-1" s="50" offset="0"/>
                            </Position>
                        </TeleportAction>
                    </PrivateAction>
                    <PrivateAction>
                        <LongitudinalAction>
                            <SpeedAction>
                                <SpeedActionDynamics dynamicsShape="step" value="1" dynamicsDimension="time"/>
                                <SpeedActionTarget>
                                    <AbsoluteTargetSpeed value="10"/>
                                </SpeedActionTarget>
                            </SpeedAction>
                        </LongitudinalAction>
                    </PrivateAction>
                </Private>
            </Actions>
        </Init>
        <Story name="story">
            <Act name="act">
                <ManeuverGroup name="empty" maximumExecutionCount="1">
                    <Actors selectTriggeringEntities="false"/>
                </ManeuverGroup>
                <StartTrigger/>
                <StopTrigger/>
            </Act>
        </Story>
        <StopTrigger>
            <ConditionGroup>
                <Condition name="stop" delay="0" conditionEdge="none">
                    <ByValueCondition>
                        <SimulationTimeCondition value="5" rule="greaterThan"/>
                    </ByValueCondition>
                </Condition>
            </ConditionGroup>
        </StopTrigger>
    </Storyboard>
</OpenSCENARIO>

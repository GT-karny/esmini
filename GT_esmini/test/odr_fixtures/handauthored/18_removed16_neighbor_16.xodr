<OpenDRIVE>
    <header revMajor="1" revMinor="6" name="18_removed16_neighbor_16" version="1.00" date="2026-07-02T00:00:00" north="0.0" south="0.0" east="0.0" west="0.0"/>
    <!-- Cluster 21: element REMOVED in OpenDRIVE 1.6. road/link/neighbor exists in the 1.5 t_road_link
         sequence (predecessor, successor, neighbor{0..2}, additionalData) but was DELETED from the 1.6
         t_road_link sequence, which permits ONLY predecessor + successor (verified via XSD diff:
         resources/schema/OpenDRIVE_1.5.xsd t_road_link vs resources/schema/OpenDRIVE_1.6/opendrive_16_road.xsd
         t_road_link). This fixture deliberately places a rev-6 header on a road that still carries the removed
         neighbor element, so the 1.6 XSD sequence rejects it (schema=fail BY DESIGN) while GT_RoadManager
         never reads road/link/neighbor at all, so RM_Init still succeeds (rm_init=pass). Exercises the
         P1 [ODR-REMOVED-1.6] diagnostic. -->
    <road name="neighbor_removed" length="100.0" id="1" junction="-1">
        <link>
            <neighbor side="left" elementId="99" direction="same"/>
        </link>
        <planView>
            <geometry s="0.0" x="0.0" y="0.0" hdg="0.0" length="100.0">
                <line/>
            </geometry>
        </planView>
        <lanes>
            <laneSection s="0.0">
                <center>
                    <lane id="0" type="none" level="false">
                        <roadMark sOffset="0.0" type="broken" weight="standard" color="standard" width="0.12" laneChange="both"/>
                    </lane>
                </center>
                <right>
                    <lane id="-1" type="driving" level="false">
                        <width sOffset="0.0" a="3.5" b="0.0" c="0.0" d="0.0"/>
                    </lane>
                </right>
            </laneSection>
        </lanes>

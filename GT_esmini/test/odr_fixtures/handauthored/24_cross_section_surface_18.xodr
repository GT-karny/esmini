        <lateralProfile>
            <!-- rev 1.8 crossSectionSurface (structure copied from the official
                 Ex_CrossSectionSurface/Ex_CrossFall_LeftTurn_1: tOffset + surfaceStrips with
                 <strip> carrying width/constant and linear coefficients). crossSectionSurface is
                 mutually exclusive with superelevation/shape (t_road_lateralProfile assert). -->
            <crossSectionSurface>
                <tOffset>
                    <coefficients s="0.0" a="-0.375"/>
                </tOffset>
                <surfaceStrips>
                    <strip id="1">
                        <width>
                            <coefficients s="0.0" a="1.5"/>
                        </width>
                        <constant>
                            <coefficients s="0.0" a="0.0"/>
                        </constant>
                    </strip>
                    <strip id="2">
                        <linear>
                            <coefficients s="0.0" a="-0.02"/>
                        </linear>
                    </strip>
                    <strip id="-1">
                        <linear>
                            <coefficients s="0.0" a="0.02"/>
                        </linear>
                    </strip>
                </surfaceStrips>
            </crossSectionSurface>
        </lateralProfile>
        <lanes>
            <laneSection s="0.0">
                <left>
                    <lane id="1" type="driving" level="false">
                        <width sOffset="0.0" a="3.5" b="0.0" c="0.0" d="0.0"/>

<?xml version="1.0" encoding="UTF-8"?>
<OpenDRIVE>
    <header revMajor="1" revMinor="8" name="03_dynamic_signal_demote_18" version="1.00" date="2026-07-02T00:00:00" north="0.0" south="0.0" east="0.0" west="0.0"/>
    <road name="main" length="150.0" id="1" junction="-1">
        <link/>
        <type s="0.0" type="town">
            <speed max="50" unit="km/h"/>
        </type>
        <planView>
            <geometry s="0.0" x="0.0" y="0.0" hdg="0.0" length="150.0">
                <line/>
            </geometry>
        </planView>
        <lanes>
            <laneOffset s="0.0" a="0.0" b="0.0" c="0.0" d="0.0"/>
            <laneSection s="0.0">
                <left>
                    <lane id="1" type="driving" level="false">
                        <link/>
                        <width sOffset="0.0" a="3.5" b="0.0" c="0.0" d="0.0"/>
                    </lane>
                </left>
                <center>
                    <lane id="0" type="none" level="false">
                        <link/>
                        <roadMark sOffset="0.0" type="broken" weight="standard" color="standard" width="0.12" laneChange="both"/>
                    </lane>
                </center>
                <right>
                    <lane id="-1" type="driving" level="false">
                        <link/>
                        <width sOffset="0.0" a="3.5" b="0.0" c="0.0" d="0.0"/>
                    </lane>
                </right>
            </laneSection>
        </lanes>
        <objects/>
        <signals>
            <!-- (a) dynamic + alpha-2 country "DE" + explicit countryRevision: classifies as static Signal today
                 (country != "opendrive" -> gate false). 1.8 idiom. -->
            <signal s="30.0" t="-4.0" id="1" name="tl_de_2021" dynamic="yes" orientation="-" zOffset="5.0"
                    country="DE" countryRevision="2021" type="1000001" subtype="-1" value="0.0" height="0.5" width="0.4"/>
            <!-- (b) dynamic + country "OpenDRIVE" WITH explicit countryRevision="2021": DEMOTE reproduction.
                 country=="opendrive" but the inverted .empty() guard at ~4821 keeps country_revision=2013,
                 so (2013 < 2013) is false -> static Signal instead of TrafficLight. This is the bug target. -->
            <signal s="70.0" t="-4.0" id="2" name="tl_odr_2021" dynamic="yes" orientation="-" zOffset="5.0"
                    country="OpenDRIVE" countryRevision="2021" type="1000001" subtype="-1" value="0.0" height="0.5" width="0.4"/>
            <!-- (c) dynamic + country "OpenDRIVE" WITHOUT countryRevision (control): the absent attr makes
                 .empty() true -> country_revision read as as_uint() of absent attr = 0, (0 < 2013) true,
                 dynamic true -> becomes a TrafficLight today. -->
            <signal s="110.0" t="-4.0" id="3" name="tl_odr_absent" dynamic="yes" orientation="-" zOffset="5.0"
                    country="OpenDRIVE" type="1000001" subtype="-1" value="0.0" height="0.5" width="0.4"/>
        </signals>
    </road>
</OpenDRIVE>

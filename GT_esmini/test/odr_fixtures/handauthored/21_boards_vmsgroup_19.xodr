<?xml version="1.0" encoding="UTF-8"?>
<OpenDRIVE>
    <header revMajor="1" revMinor="9" name="21_boards_vmsgroup_19" version="1.00" date="2026-07-02T00:00:00" north="0.0" south="0.0" east="0.0" west="0.0"/>
    <road name="main" length="200.0" id="1" junction="-1">
        <link/>
        <type s="0.0" type="motorway">
            <speed max="130" unit="km/h"/>
        </type>
        <planView>
            <geometry s="0.0" x="0.0" y="0.0" hdg="0.0" length="200.0">
                <line/>
            </geometry>
        </planView>
        <lanes>
            <laneOffset s="0.0" a="0.0" b="0.0" c="0.0" d="0.0"/>
            <laneSection s="0.0">
                <left>
                    <lane id="1" type="driving" level="false">
                        <link/>
                        <width sOffset="0.0" a="3.5" b="0.0" c="0.0" d="0.0"/>
                    </lane>
                </left>
                <center>
                    <lane id="0" type="none" level="false">
                        <link/>
                        <roadMark sOffset="0.0" type="broken" weight="standard" color="standard" width="0.12" laneChange="both"/>
                    </lane>
                </center>
                <right>
                    <lane id="-1" type="driving" level="false">
                        <link/>
                        <width sOffset="0.0" a="3.5" b="0.0" c="0.0" d="0.0"/>
                    </lane>
                </right>
            </laneSection>
        </lanes>
        <objects/>
        <signals>
            <!-- 1.9 gantry signal carrying BOTH board kinds in the 1.9 placement (staticBoard +
                 vmsBoard are children of <signal> in t_road_signals_signal_road, same as 1.8). The
                 type="multiBoard" dynamic signal is the ASAM canonical multi-board gantry. -->
            <signal s="120.0" t="0.0" id="1" name="gantry_multiboard" dynamic="yes" orientation="+" zOffset="6.0"
                    country="DE" type="multiBoard" subtype="-1" height="2.5" width="6.0">
                <staticBoard>
                    <sign v="0.0" z="6.0"/>
                </staticBoard>
                <vmsBoard displayType="LED" displayWidth="4.0" displayHeight="2.0" v="2.0" z="6.0">
                    <displayArea index="0" v="2.0" z="6.0" width="4.0" height="2.0"/>
                </vmsBoard>
            </signal>
            <!-- second gantry-adjacent VMS so the vmsGroup groups two boards -->
            <signal s="120.0" t="-4.0" id="2" name="gantry_vms_2" dynamic="yes" orientation="+" zOffset="6.0"
                    country="DE" type="1000001" subtype="-1" height="2.0" width="4.0">
                <vmsBoard displayType="simpleMatrix" displayWidth="4.0" displayHeight="2.0" v="0.0" z="6.0">
                    <displayArea index="0" v="0.0" z="6.0" width="4.0" height="2.0"/>
                </vmsBoard>
            </signal>
        </signals>
    </road>
    <!-- 1.9 document-level <vmsGroup>: groups the two gantry VMS boards. The mandatory XSD-1.1
         <_OpenDriveElement/> placeholder (t_signalGroup_vmsGroup, minOccurs=1) is authored per the
         schema; it, like defaultRegulations, makes strict-XSD-1.1 validation an expected FAIL. -->
    <vmsGroup id="gantry_group_1">
        <vmsBoardReference signalId="1" vmsIndex="0" groupIndex="0"/>
        <vmsBoardReference signalId="2" vmsIndex="0" groupIndex="1"/>
        <_OpenDriveElement/>
    </vmsGroup>
</OpenDRIVE>

    <!-- Junction 2: first connection is valid; the SECOND references connectingRoad "99" which does not
         exist. Schema-valid under 1.4H (OpenDRIVE_1.4H.xsd has ZERO xs:keyref, so junction/connection/
         @connectingRoad referential integrity is NOT enforced; IDs are plain xsd:string). GT_RoadManager.cpp:5433
         aborts the whole parse with LOG_WARN "Missing connecting road with id 99", returns false, RM_Init fails.
         Relabeled from revMinor=5 to 1.4H because the 1.5 XSD keyref r_junction_connection_connectingRoad rejects
         the dangling ref, which would make schema=pass and the RM abort mutually exclusive. -->
    <junction name="brokenJunction" id="2">
        <connection id="0" incomingRoad="1" connectingRoad="10" contactPoint="start">
            <laneLink from="-1" to="-1"/>
        </connection>
        <connection id="1" incomingRoad="1" connectingRoad="99" contactPoint="start">
            <laneLink from="-1" to="-1"/>
        </connection>
    </junction>
</OpenDRIVE>

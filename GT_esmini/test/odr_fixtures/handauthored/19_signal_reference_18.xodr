<?xml version="1.0" encoding="UTF-8"?>
<OpenDRIVE>
    <header revMajor="1" revMinor="8" name="19_signal_reference_18" version="1.00" date="2026-07-03T00:00:00" north="0.0" south="0.0" east="0.0" west="0.0"/>
    <!-- Road 1 owns the referenced signals; road 2 carries the <signalReference> elements.
         P3 [GT_ODR:sig-ref]: each reference is materialized as a CLONE on road 2 carrying the
         reference's s/t/orientation/validity (dynamic target -> TrafficLight clone).
         NOTE: a dangling reference cannot live here: the 1.8 XSD keyref k_road_signals_signalId
         rejects it (P0 known trap). The WARN+skip path is unit-tested with a temp file
         (test_OdrForkPatches.SignalReferenceDanglingSkip) and observed on the official
         UC_5Road_Junction fixture. -->
    <road name="main" length="150.0" id="1" junction="-1">
        <link/>
        <type s="0.0" type="town"/>
        <planView>
            <geometry s="0.0" x="0.0" y="0.0" hdg="0.0" length="150.0">
                <line/>
            </geometry>
        </planView>
        <lanes>
            <laneOffset s="0.0" a="0.0" b="0.0" c="0.0" d="0.0"/>
            <laneSection s="0.0">
                <left>
                    <lane id="1" type="driving" level="false">
                        <link/>
                        <width sOffset="0.0" a="3.5" b="0.0" c="0.0" d="0.0"/>
                    </lane>
                </left>
                <center>
                    <lane id="0" type="none" level="false">
                        <link/>
                        <roadMark sOffset="0.0" type="broken" weight="standard" color="standard" width="0.12" laneChange="both"/>
                    </lane>
                </center>
                <right>
                    <lane id="-1" type="driving" level="false">
                        <link/>
                        <width sOffset="0.0" a="3.5" b="0.0" c="0.0" d="0.0"/>
                    </lane>
                </right>
            </laneSection>
        </lanes>
        <objects/>
        <signals>
            <!-- dynamic traffic light (TrafficLight since [GT_ODR:tl-gate]); also carries the
                 cluster-12 L1 children <dependency> and <reference> (stored in OdrSignalExtras). -->
            <signal s="100.0" t="-4.0" id="1" name="tl_main" dynamic="yes" orientation="+" zOffset="4.0"
                    country="OpenDRIVE" type="1000001" subtype="-1" height="0.9" width="0.4">
                <dependency id="2" type="limitLine"/>
                <reference elementType="signal" elementId="2" type="controls"/>
            </signal>
            <!-- static sign (plain Signal) -->
            <signal s="110.0" t="-4.0" id="2" name="stop_main" dynamic="no" orientation="+" zOffset="2.0"
                    country="DE" type="206" subtype="-1" height="0.6" width="0.6"/>
        </signals>
    </road>
    <road name="secondary" length="100.0" id="2" junction="-1">
        <link/>
        <type s="0.0" type="town"/>
        <planView>
            <geometry s="0.0" x="200.0" y="0.0" hdg="0.0" length="100.0">
                <line/>
            </geometry>
        </planView>
        <lanes>
            <laneOffset s="0.0" a="0.0" b="0.0" c="0.0" d="0.0"/>
            <laneSection s="0.0">
                <left>
                    <lane id="1" type="driving" level="false">
                        <link/>
                        <width sOffset="0.0" a="3.5" b="0.0" c="0.0" d="0.0"/>
                    </lane>
                </left>
                <center>
                    <lane id="0" type="none" level="false">
                        <link/>
                        <roadMark sOffset="0.0" type="broken" weight="standard" color="standard" width="0.12" laneChange="both"/>
                    </lane>
                </center>
                <right>
                    <lane id="-1" type="driving" level="false">
                        <link/>
                        <width sOffset="0.0" a="3.5" b="0.0" c="0.0" d="0.0"/>
                    </lane>
                </right>
            </laneSection>
        </lanes>
        <objects/>
        <signals>
            <!-- clone of the dynamic light, valid for the right lane only -->
            <signalReference s="50.0" t="-4.0" id="1" orientation="+">
                <validity fromLane="-1" toLane="-1"/>
            </signalReference>
            <!-- clone of the static sign, opposite orientation -->
            <signalReference s="60.0" t="4.0" id="2" orientation="-"/>
        </signals>
    </road>
</OpenDRIVE>

    <!-- Three incoming arms feeding a common junction (id=100), plus a document-level
         <junctionGroup type="roundabout"> referencing it via <junctionReference>. junctionGroup
         is valid since <=1.5 (OpenDRIVE_1.5.xsd t_junctionGroup, no _OpenDriveElement defect); the
         roundabout enum is one of {roundabout, unknown}. L1 fixture only. -->
    <road name="arm_w" length="50.0" id="1" junction="-1">
        <link>
            <successor elementType="junction" elementId="100"/>
        </link>
        <planView>

						<link/>
						<width sOffset="0.0000000000000000e+00" a="1.6799999999999999e+00" b="0.0" c="0.0" d="0.0"/>
					</lane>
					<lane id="1" type="driving" level="false">
						<link/>
						<width sOffset="0.0000000000000000e+00" a="3.0699999999999998e+00" b="0.0" c="0.0" d="0.0"/>
						<roadMark sOffset="0.0" type="solid" weight="standard" color="standard" width="1.2000000000000000e-01" laneChange="none"/>
					</lane>

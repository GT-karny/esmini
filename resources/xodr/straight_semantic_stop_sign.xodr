<?xml version="1.0" ?>
<!-- GT_esmini P4 verification asset: 500 m straight 2-lane road with a single
     signal whose OpenDRIVE @type (9001) is NOT in the de catalog, so the
     country-catalog pipeline leaves it OSI-unclassified (osi_type == the
     INT_MAX "no catalog match" sentinel, i.e. neither TYPE_STOP nor
     TYPE_GIVE_WAY). Its <semantics><priority type="stopLine"/></semantics>
     is what the P4 L2 fallback (StopYieldSignAware) classifies as a STOP.
     Cloned from straight_stop_sign.xodr; the type was changed from 206 (=STOP
     in de) to the unused 9001 and the semantics block added. NO @value
     attribute (unset value -> value_ == 0.0). Used by
     04_traffic_signs/semantic_stop_sign_*. -->
<OpenDRIVE>
	<header revMajor="1" revMinor="9" name="straight_semantic_stop_sign" version="1.00" date="2026-06-04" north="0.0" south="0.0" east="0.0" west="0.0"/>
	<road name="" length="5.0000000000000000e+02" id="1" junction="-1">
		<link/>
		<type s="0.0" type="town">
			<speed unit="km/h" max="50"/>
		</type>
		<planView>

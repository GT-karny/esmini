<?xml version="1.0" encoding="UTF-8"?>
<OpenSCENARIO>
   <FileHeader revMajor="1" revMinor="1" date="2026-02-09T10:00:00" description="RealDriver action support verification" author="Codex"/>
   <ParameterDeclarations/>
   <CatalogLocations>
      <VehicleCatalog>
         <Directory path="../xosc/Catalogs/Vehicles"/>
      </VehicleCatalog>
   </CatalogLocations>
   <RoadNetwork>
      <LogicFile filepath="../xodr/fabriksgatan.xodr"/>
      <SceneGraphFile filepath="../models/fabriksgatan.osgb"/>
   </RoadNetwork>
   <Entities>
      <ScenarioObject name="Ego">
         <CatalogReference catalogName="VehicleCatalog" entryName="car_white"/>
         <ObjectController>
            <Controller name="RealDriverController">
               <Properties>
                  <Property name="esminiController" value="RealDriverController"/>
                  <Property name="BasePort" value="53995"/>
                  <Property name="SendWaypoints" value="true"/>
                  <Property name="WaypointPort" value="54996"/>
               </Properties>
            </Controller>
         </ObjectController>
      </ScenarioObject>
      <ScenarioObject name="Lead">
         <CatalogReference catalogName="VehicleCatalog" entryName="car_blue"/>
      </ScenarioObject>
   </Entities>
   <Storyboard>
      <Init>
         <Actions>
            <Private entityRef="Ego">
               <PrivateAction>
                  <TeleportAction>
                     <Position>
                        <LanePosition roadId="0" laneId="-1" offset="0" s="30"/>
                     </Position>
                  </TeleportAction>
               </PrivateAction>
               <PrivateAction>
                  <LongitudinalAction>
                     <SpeedAction>
                        <SpeedActionDynamics dynamicsShape="step" dynamicsDimension="time" value="0.0"/>
                        <SpeedActionTarget>
                           <AbsoluteTargetSpeed value="12.0"/>
                        </SpeedActionTarget>
                     </SpeedAction>
                  </LongitudinalAction>
               </PrivateAction>
               <PrivateAction>
                  <ActivateControllerAction longitudinal="true" lateral="true"/>
               </PrivateAction>
            </Private>
            <Private entityRef="Lead">
               <PrivateAction>
                  <TeleportAction>
                     <Position>
                        <LanePosition roadId="0" laneId="-1" offset="0" s="60"/>
                     </Position>
                  </TeleportAction>
               </PrivateAction>
               <PrivateAction>
                  <LongitudinalAction>
                     <SpeedAction>
                        <SpeedActionDynamics dynamicsShape="step" dynamicsDimension="time" value="0.0"/>
                        <SpeedActionTarget>
                           <AbsoluteTargetSpeed value="8.0"/>
                        </SpeedActionTarget>
                     </SpeedAction>
                  </LongitudinalAction>
               </PrivateAction>
            </Private>
         </Actions>
      </Init>
      <Story name="ActionSupportStory">
         <Act name="ActionSupportAct">
            <ManeuverGroup maximumExecutionCount="1" name="EgoGroup">
               <Actors selectTriggeringEntities="false">
                  <EntityRef entityRef="Ego"/>
               </Actors>
               <Maneuver name="EgoManeuver">
                  <Event name="LongDistanceEvent" priority="overwrite">
                     <Action name="LongDistanceAction">
                        <PrivateAction>
                           <LongitudinalAction>
                              <LongitudinalDistanceAction continuous="true" entityRef="Lead" timeGap="1.5" freespace="true">
                                 <DynamicConstraints maxAcceleration="2.0" maxDeceleration="4.0" maxSpeed="20.0"/>
                              </LongitudinalDistanceAction>
                           </LongitudinalAction>
                        </PrivateAction>
                     </Action>
                     <StartTrigger>
                        <ConditionGroup>
                           <Condition name="StartLongDistance" delay="0" conditionEdge="rising">
                              <ByValueCondition>
                                 <SimulationTimeCondition value="0.5" rule="greaterThan"/>
                              </ByValueCondition>
                           </Condition>
                        </ConditionGroup>
                     </StartTrigger>
                  </Event>
                  <Event name="LaneOffsetEvent" priority="overwrite">
                     <Action name="LaneOffsetAction">
                        <PrivateAction>
                           <LateralAction>
                              <LaneOffsetAction continuous="true">
                                 <LaneOffsetActionDynamics dynamicsShape="sinusoidal" maxLateralAcc="1.5"/>
                                 <LaneOffsetTarget>
                                    <AbsoluteTargetLaneOffset value="0.8"/>
                                 </LaneOffsetTarget>
                              </LaneOffsetAction>
                           </LateralAction>
                        </PrivateAction>
                     </Action>
                     <StartTrigger>
                        <ConditionGroup>
                           <Condition name="StartLaneOffset" delay="0" conditionEdge="rising">
                              <ByValueCondition>
                                 <SimulationTimeCondition value="1.5" rule="greaterThan"/>
                              </ByValueCondition>
                           </Condition>
                        </ConditionGroup>
                     </StartTrigger>
                  </Event>
                  <Event name="FollowTrajectoryEvent" priority="overwrite">
                     <Action name="FollowTrajectoryAction">
                        <PrivateAction>
                           <RoutingAction>
                              <FollowTrajectoryAction>
                                 <TrajectoryRef>
                                    <Trajectory name="MiniTrajectory" closed="false">
                                       <ParameterDeclarations/>
                                       <Shape>
                                          <Polyline>
                                             <Vertex><Position><WorldPosition x="50.0" y="-1.53" h="0.0"/></Position></Vertex>
                                             <Vertex><Position><WorldPosition x="80.0" y="-1.53" h="0.0"/></Position></Vertex>
                                             <Vertex><Position><WorldPosition x="110.0" y="1.53" h="0.1"/></Position></Vertex>
                                          </Polyline>
                                       </Shape>
                                    </Trajectory>
                                 </TrajectoryRef>
                                 <TimeReference>
                                    <None/>
                                 </TimeReference>
                                 <TrajectoryFollowingMode followingMode="position"/>
                              </FollowTrajectoryAction>
                           </RoutingAction>
                        </PrivateAction>
                     </Action>
                     <StartTrigger>
                        <ConditionGroup>
                           <Condition name="StartFollowTrajectory" delay="0" conditionEdge="rising">
                              <ByValueCondition>
                                 <SimulationTimeCondition value="3.0" rule="greaterThan"/>
                              </ByValueCondition>
                           </Condition>
                        </ConditionGroup>
                     </StartTrigger>
                  </Event>
                  <Event name="AssignRouteEvent" priority="overwrite">
                     <Action name="AssignRouteAction">
                        <PrivateAction>
                           <RoutingAction>
                              <AssignRouteAction>
                                 <Route name="EgoRoute" closed="false">
                                    <Waypoint routeStrategy="shortest">
                                       <Position>
                                          <LanePosition roadId="0" laneId="-1" offset="0.0" s="90"/>
                                       </Position>
                                    </Waypoint>
                                    <Waypoint routeStrategy="shortest">
                                       <Position>
                                          <LanePosition roadId="0" laneId="-1" offset="0.0" s="160"/>
                                       </Position>
                                    </Waypoint>
                                 </Route>
                              </AssignRouteAction>
                           </RoutingAction>
                        </PrivateAction>
                     </Action>
                     <StartTrigger>
                        <ConditionGroup>
                           <Condition name="StartAssignRoute" delay="0" conditionEdge="rising">
                              <ByValueCondition>
                                 <SimulationTimeCondition value="4.5" rule="greaterThan"/>
                              </ByValueCondition>
                           </Condition>
                        </ConditionGroup>
                     </StartTrigger>
                  </Event>
               </Maneuver>
            </ManeuverGroup>
            <StartTrigger>
               <ConditionGroup>
                  <Condition name="StartAct" delay="0" conditionEdge="rising">
                     <ByValueCondition>
                        <SimulationTimeCondition value="0" rule="greaterThan"/>
                     </ByValueCondition>
                  </Condition>
               </ConditionGroup>
            </StartTrigger>
         </Act>
      </Story>
      <StopTrigger>
         <ConditionGroup>
            <Condition name="StopAt8s" delay="0" conditionEdge="rising">
               <ByValueCondition>
                  <SimulationTimeCondition value="8.0" rule="greaterThan"/>
               </ByValueCondition>
            </Condition>
         </ConditionGroup>
      </StopTrigger>
   </Storyboard>
</OpenSCENARIO>

<?xml version='1.0' encoding='utf-8'?>
<OpenDRIVE>
    <!-- P5 crossPath variant of road_catalog/generated/straight_crosswalk__mid.xodr (acceptance ii).
         Road 0 is byte-for-byte the catalog road MINUS the authored <object type="crosswalk">; the
         crossing is instead encoded as a crossPath on a virtual junction (id 900) over a dedicated
         pedestrian road (id 1). The GT crossPath->CROSSWALK synthesis (OdrJunctionExtras.cpp) then
         reconstructs a closed 4-corner CROSSWALK RMObject straddling road 0 at s=250, which
         CrosswalkPedestrianAware picks up with ZERO policy-code change. Header bumped 1.5 -> 1.8
         because <crossPath> is a >=1.8 element (t_junction_virtual/common). -->
    <header name="straight_crosswalk_crosspath" revMajor="1" revMinor="8" date="2026-07-03 00:00:00.000000" north="0.0" south="0.0" east="0.0" west="0.0"/>
    <road rule="RHT" id="0" junction="-1" length="500.0">
        <link/>
        <planView>
            <geometry s="0" x="0" y="0" hdg="0" length="500.0">
                <line/>
            </geometry>
        </planView>
        <elevationProfile/>
        <lateralProfile/>
        <lanes>
            <laneSection s="0">
                <left>
                    <lane id="2" type="sidewalk" level="false">
                        <link/>
                        <width a="2.0" b="0" c="0" d="0" sOffset="0"/>
                    </lane>
                    <lane id="1" type="driving" level="false">
                        <link/>
                        <width a="3.5" b="0" c="0" d="0" sOffset="0"/>
                        <roadMark sOffset="0" type="solid" weight="standard" color="standard" width="0.2"/>
                    </lane>
                </left>
                <center>
                    <lane id="0" type="none" level="false">
                        <roadMark sOffset="0" type="broken" weight="standard" color="standard" width="0.2">
                            <type name="broken" width="0.2">
                                <line length="3" space="9" tOffset="0" width="0.15" sOffset="0"/>
                            </type>
                        </roadMark>
                    </lane>
                </center>
                <right>
                    <lane id="-1" type="driving" level="false">
                        <link/>
                        <width a="3.5" b="0" c="0" d="0" sOffset="0"/>
                        <roadMark sOffset="0" type="solid" weight="standard" color="standard" width="0.2"/>
                    </lane>
                    <lane id="-2" type="sidewalk" level="false">
                        <link/>
                        <width a="2.0" b="0" c="0" d="0" sOffset="0"/>
                    </lane>
                </right>
            </laneSection>
        </lanes>
        <objects/>
    </road>
    <!-- Pedestrian crossing road: single walking lane, runs perpendicular to road 0 through the
         crossing point (250, 0). Length 8 spanning y in [-4, 4] (from (250,-4) heading +y), so its
         centerline midpoint (s=4) lands on road 0's centerline at s=250. Deliberately kept to the
         drivable carriageway extent (NOT out to the sidewalks): the scene-09 pedestrian's
         FollowTrajectory ends on road 0's sidewalk lane -2 at y=-4.59, and a crossing road that
         reached that far would capture the pedestrian's post-trajectory localization onto ITSELF
         (heading -y) instead of road 0 (heading +x), perturbing the invariance-control ped path.
         Walking-lane width 4.0 -> synthesized crosswalk half-width along road 0 = 2.0 -> s-extent
         [248, 252] (matches the original object footprint). -->
    <road name="pedestrian" length="8.0" id="1" junction="-1" rule="RHT">
        <link/>
        <type s="0.0" type="town"/>
        <planView>
            <geometry s="0.0" x="250.0" y="-4.0" hdg="1.5707963267948966" length="8.0">
                <line/>
            </geometry>
        </planView>
        <elevationProfile/>
        <lateralProfile/>
        <lanes>
            <laneSection s="0.0">
                <center>
                    <lane id="0" type="none" level="false">
                        <link/>
                    </lane>
                </center>
                <right>
                    <lane id="-1" type="walking" level="false">
                        <link/>
                        <width a="4.0" b="0.0" c="0.0" d="0.0" sOffset="0.0"/>
                    </lane>
                </right>
            </laneSection>
        </lanes>
        <objects/>
    </road>
    <!-- Virtual junction carrying the crossPath (pedestrian crossing) + a priority for good measure.
         crossingRoad = the pedestrian road (1); roadAtStart/roadAtEnd = the crossed road (0);
         startLaneLink@s = the crossed-road s (250) at which the crossing sits. -->
    <junction name="crosswalkCrossPath" type="virtual" id="900" mainRoad="0" sStart="248.0" sEnd="252.0" orientation="none">
        <crossPath id="0" crossingRoad="1" roadAtStart="0" roadAtEnd="0">
            <startLaneLink s="250.0" from="2" to="-1"/>
            <endLaneLink s="250.0" from="-2" to="-1"/>
        </crossPath>
        <priority high="0" low="1"/>
    </junction>
</OpenDRIVE>

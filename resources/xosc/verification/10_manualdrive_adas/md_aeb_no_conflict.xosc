<?xml version="1.0" encoding="UTF-8"?>
<!--
  ManualDrive ADAS verification scenario 10_manualdrive_adas / md_aeb_no_conflict
  (REQ-AD-025 step b, negative; slug md-aeb-no-false-intervention).

  Geometry is 07_aeb/normal_following.xosc's SOTIF-mirror setup (ordinary same-lane
  follow, no cut-in, no hard brake) with the Ego's controller swapped to
  ManualDriveController and a scripted "steady_throttle" human input profile
  (constant low throttle, no braking, no steering). AEB stays ENABLED
  (manualdrive_config adas_aeb_enabled=true) but there is no collision course, so
  it must never touch the human's pedals.

  Unlike the VD original, the bumper gap is widened from ~50 m to ~65 m
  (LeadStartS 85 -> 100) as a deliberate safety margin: under VirtualDriverController
  the Story-level SpeedAction pins Ego's speed exactly, but under ManualDriveController
  Ego's speed is whatever RealVehicleBackend's pedal-driven physics produces from the
  "steady_throttle" input (see that profile's description - throttle=0.30 is an
  uncalibrated guess). The wider gap is meant to absorb that uncertainty the same way
  the VD original's TTC margin (actual TTC 12.0s vs. AebSafety's ~2.5s gate, a 4.8x
  margin - see normal_following.md) already absorbed worst-case constant-speed
  kinematics. Ego's ManeuverGroup carries no scripted longitudinal action (unlike the
  VD original's CruiseManeuver) because ManualDriveController does not consume
  LongitudinalAction for a domain it owns; the Init TeleportAction/SpeedAction seeds
  RealVehicleBackend's starting speed and the scripted pedal profile drives it from
  there (see RealVehicleBackend::SetInitialState).

  Requires OSI capture (batch osi:true) for parity with the rest of the batch, even
  though no_intervention_in_window / adas_state_matches read HVD.
-->
<OpenSCENARIO>
   <FileHeader revMajor="1" revMinor="3" date="2026-08-04T00:00:00"
               description="ManualDrive ADAS verification: steady driver, ordinary following, AEB must not fire (negative)" author="GT_esmini"/>
   <ParameterDeclarations>
      <ParameterDeclaration name="EgoSpeed"   parameterType="double" value="25.0"/>  <!-- 90 km/h -->
      <ParameterDeclaration name="LeadSpeed"  parameterType="double" value="23.0"/>  <!-- 82.8 km/h -->
      <ParameterDeclaration name="LeadStartS" parameterType="double" value="100.0"/>  <!-- ~65 m bumper gap ahead of Ego; widened vs. VD's 85 for scripted-pedal margin -->
   </ParameterDeclarations>
   <CatalogLocations/>
   <RoadNetwork>
      <LogicFile filepath="../../../xodr/straight_500m_2lane.xodr"/>
   </RoadNetwork>
   <Entities>
      <ScenarioObject name="Ego">
         <Vehicle name="car_white" vehicleCategory="car" model3d="../../../models/car_white.osgb">
            <BoundingBox>
               <Center x="1.4" y="0.0" z="0.9"/>
               <Dimensions width="2.0" length="5.0" height="1.8"/>
            </BoundingBox>
            <Performance maxSpeed="69" maxDeceleration="30" maxAcceleration="10"/>
            <Axles>
               <FrontAxle maxSteering="30" wheelDiameter="0.8" trackWidth="1.68" positionX="2.98" positionZ="0.4"/>
               <RearAxle maxSteering="30" wheelDiameter="0.8" trackWidth="1.68" positionX="0" positionZ="0.4"/>
            </Axles>
            <Properties>
               <Property name="model_id" value="0"/>
               <Property name="scaleMode" value="ModelToBB"/>
            </Properties>
         </Vehicle>
         <ObjectController>
            <Controller name="ManualDriveController">
               <Properties>
                  <Property name="esminiController" value="ManualDriveController"/>
                  <Property name="ConfigFile" value="manual_drive_headless_stub.json"/>
               </Properties>
            </Controller>
         </ObjectController>
      </ScenarioObject>
      <ScenarioObject name="Lead">
         <Vehicle name="car_red" vehicleCategory="car" model3d="../../../models/car_red.osgb">
            <BoundingBox>
               <Center x="1.4" y="0.0" z="0.9"/>
               <Dimensions width="2.0" length="5.0" height="1.8"/>
            </BoundingBox>
            <Performance maxSpeed="69" maxDeceleration="30" maxAcceleration="10"/>
            <Axles>
               <FrontAxle maxSteering="30" wheelDiameter="0.8" trackWidth="1.68" positionX="2.98" positionZ="0.4"/>
               <RearAxle maxSteering="30" wheelDiameter="0.8" trackWidth="1.68" positionX="0" positionZ="0.4"/>
            </Axles>
            <Properties>
               <Property name="model_id" value="1"/>
               <Property name="scaleMode" value="ModelToBB"/>
            </Properties>
         </Vehicle>
      </ScenarioObject>
   </Entities>
   <Storyboard>
      <Init>
         <Actions>
            <Private entityRef="Ego">
               <PrivateAction>
                  <TeleportAction>
                     <Position><LanePosition roadId="1" laneId="-1" offset="0" s="30"/></Position>
                  </TeleportAction>
               </PrivateAction>
               <PrivateAction>
                  <LongitudinalAction>
                     <SpeedAction>
                        <SpeedActionDynamics dynamicsShape="step" value="0" dynamicsDimension="time"/>
                        <SpeedActionTarget><AbsoluteTargetSpeed value="$EgoSpeed"/></SpeedActionTarget>
                     </SpeedAction>
                  </LongitudinalAction>
               </PrivateAction>
               <PrivateAction>
                  <ControllerAction>
                     <ActivateControllerAction objectControllerRef="ManualDriveController" lateral="true" longitudinal="true"/>
                  </ControllerAction>
               </PrivateAction>
            </Private>
            <Private entityRef="Lead">
               <PrivateAction>
                  <TeleportAction>
                     <Position><LanePosition roadId="1" laneId="-1" offset="0" s="$LeadStartS"/></Position>
                  </TeleportAction>
               </PrivateAction>
               <PrivateAction>
                  <LongitudinalAction>
                     <SpeedAction>
                        <SpeedActionDynamics dynamicsShape="step" value="0" dynamicsDimension="time"/>
                        <SpeedActionTarget><AbsoluteTargetSpeed value="$LeadSpeed"/></SpeedActionTarget>
                     </SpeedAction>
                  </LongitudinalAction>
               </PrivateAction>
            </Private>
         </Actions>
      </Init>
      <Story name="FollowStory">
         <Act name="FollowAct">
            <ManeuverGroup maximumExecutionCount="1" name="EgoSequence">
               <Actors selectTriggeringEntities="false"><EntityRef entityRef="Ego"/></Actors>
            </ManeuverGroup>
            <StartTrigger>
               <ConditionGroup>
                  <Condition name="ActStart" delay="0" conditionEdge="none">
                     <ByValueCondition><SimulationTimeCondition value="0" rule="greaterThan"/></ByValueCondition>
                  </Condition>
               </ConditionGroup>
            </StartTrigger>
         </Act>
      </Story>
      <StopTrigger>
         <ConditionGroup>
            <Condition name="StopCondition" delay="0" conditionEdge="rising">
               <ByValueCondition><SimulationTimeCondition value="13" rule="greaterThan"/></ByValueCondition>
            </Condition>
         </ConditionGroup>
      </StopTrigger>
   </Storyboard>
</OpenSCENARIO>

<?xml version="1.0" encoding="UTF-8"?>
<!--
  ManualDrive ADAS verification scenario 10_manualdrive_adas / md_msl_throttle_cap
  (req-vd-ad:REQ-AD-030 step a, vd-func:FUNC-081; slugs md-msl-throttle-cap and
  md-msl-no-brake-downhill). Added 2026-08-05 (phase C).

  Empty road. The driver switches the limiter on at t=1.0 while travelling at 20 m/s
  - which SETs the cap there - and then holds a heavy 0.85 throttle for the rest of
  the run (msl_ops_steady_throttle.json; 0.85 rather than 1.0 because 1.0 would trip
  the kickdown RELEASE and the run would measure the opposite of what it claims -
  see that profile's description).

  THIS RUN CARRIES BOTH OF step a's HALVES, positive and negative. The positive is
  that the vehicle does not exceed the cap despite a throttle that would otherwise
  take it well past. The negative is that the limiter never produces a BRAKE:
  gt.msl.brake_out is emitted every frame and must stay identically zero.

  ON THE MISSING DOWNHILL. The verification plan originally reached the negative via
  a descent (MDA-XODR-02), on the reasoning that gravity would push the vehicle over
  the cap and a limiter that braked would be caught pulling it back. That asset was
  NOT built: RealVehicle applies road pitch to attitude only - terrain_pitch_ never
  enters the longitudinal dynamics - so a graded road would look like a descent and
  behave like level ground, and the asset would have been named for a phenomenon it
  cannot produce. The claim is instead reached here, on the flat: no brake is
  commanded at any point, including while the cap is actively biting. See
  straight_500m_speed_limit_step.xodr's header and the verification plan §3-1 for
  the record.
-->
<OpenSCENARIO>
   <FileHeader revMajor="1" revMinor="3" date="2026-08-05T00:00:00"
               description="ManualDrive ADAS verification: speed limiter caps a heavy throttle and never brakes" author="GT_esmini"/>
   <ParameterDeclarations>
      <ParameterDeclaration name="EgoSpeed" parameterType="double" value="20.0"/>
   </ParameterDeclarations>
   <CatalogLocations/>
   <RoadNetwork>
      <LogicFile filepath="../../../xodr/straight_500m_2lane.xodr"/>
   </RoadNetwork>
   <Entities>
      <ScenarioObject name="Ego">
         <Vehicle name="car_white" vehicleCategory="car" model3d="../../../models/car_white.osgb">
            <BoundingBox>
               <Center x="1.4" y="0.0" z="0.9"/>
               <Dimensions width="2.0" length="5.0" height="1.8"/>
            </BoundingBox>
            <Performance maxSpeed="69" maxDeceleration="30" maxAcceleration="10"/>
            <Axles>
               <FrontAxle maxSteering="30" wheelDiameter="0.8" trackWidth="1.68" positionX="2.98" positionZ="0.4"/>
               <RearAxle maxSteering="30" wheelDiameter="0.8" trackWidth="1.68" positionX="0" positionZ="0.4"/>
            </Axles>
            <Properties>
               <Property name="model_id" value="0"/>
               <Property name="scaleMode" value="ModelToBB"/>
            </Properties>
         </Vehicle>
         <ObjectController>
            <Controller name="ManualDriveController">
               <Properties>
                  <Property name="esminiController" value="ManualDriveController"/>
                  <Property name="ConfigFile" value="manual_drive_headless_stub.json"/>
               </Properties>
            </Controller>
         </ObjectController>
      </ScenarioObject>
   </Entities>
   <Storyboard>
      <Init>
         <Actions>
            <Private entityRef="Ego">
               <PrivateAction>
                  <TeleportAction>
                     <Position><LanePosition roadId="1" laneId="-1" offset="0" s="30"/></Position>
                  </TeleportAction>
               </PrivateAction>
               <PrivateAction>
                  <LongitudinalAction>
                     <SpeedAction>
                        <SpeedActionDynamics dynamicsShape="step" value="0" dynamicsDimension="time"/>
                        <SpeedActionTarget><AbsoluteTargetSpeed value="$EgoSpeed"/></SpeedActionTarget>
                     </SpeedAction>
                  </LongitudinalAction>
               </PrivateAction>
               <PrivateAction>
                  <ControllerAction>
                     <ActivateControllerAction objectControllerRef="ManualDriveController" lateral="true" longitudinal="true"/>
                  </ControllerAction>
               </PrivateAction>
            </Private>
         </Actions>
      </Init>
      <Story name="MslThrottleCapStory">
         <Act name="MslThrottleCapAct">
            <ManeuverGroup maximumExecutionCount="1" name="EgoSequence">
               <Actors selectTriggeringEntities="false"><EntityRef entityRef="Ego"/></Actors>
            </ManeuverGroup>
            <StartTrigger>
               <ConditionGroup>
                  <Condition name="ActStart" delay="0" conditionEdge="none">
                     <ByValueCondition><SimulationTimeCondition value="0" rule="greaterThan"/></ByValueCondition>
                  </Condition>
               </ConditionGroup>
            </StartTrigger>
         </Act>
      </Story>
      <StopTrigger>
         <ConditionGroup>
            <Condition name="StopCondition" delay="0" conditionEdge="rising">
               <ByValueCondition><SimulationTimeCondition value="20" rule="greaterThan"/></ByValueCondition>
            </Condition>
         </ConditionGroup>
      </StopTrigger>
   </Storyboard>
</OpenSCENARIO>

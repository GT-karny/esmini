<?xml version="1.0" encoding="UTF-8"?>
<!--
  ManualDrive ADAS verification scenario 10_manualdrive_adas / md_aeb_strong_brake_driver
  (REQ-AD-025 step c, slug md-aeb-brake-not-stacked).

  Geometry is 07_aeb/cutin_hard_brake.xosc verbatim (same as md_aeb_unresponsive.xosc
  in this directory) with the Ego's controller swapped to ManualDriveController and a
  scripted "strong_brake_at" human input profile.

  RETUNED 2026-08-05 from mdadas_run1's real telemetry (see
  profiles/strong_brake_at.json's description and md_aeb_strong_brake_driver.md for
  the full derivation): the original guess (brake onset t=3.0) landed entirely after
  this geometry's measured AEB-active window (t=1.75-2.85, contact by t~2.9), so AEB
  was never observed ACTIVE and brake_not_stacked SKIPped with nothing to check.
  Brake now ramps to full (1.0) at t=1.55-1.60, shortly BEFORE the measured t=1.75
  candidate-admission point, so the driver is already at maximum brake by the time
  AEB's gate trips. brake=1.0 maps to physics max_dec=10.0 m/s^2
  (real_vehicle_params.json); the measured gt.aeb.brake_request in the reference run
  is ALSO already near 1.0 the instant the candidate is admitted (a_req=11.46, far
  past adas_brake_full_decel_mps2=8.0's saturation point), which is why this profile
  targets the same ceiling rather than some intermediate level - see the .md for why
  that makes this asset's coverage of brake_not_stacked GREEN-only (per the
  verification plan's own documented split for this matcher), not a weaker test than
  originally intended.

  Ego's ManeuverGroup carries no scripted longitudinal action, matching the other
  ManualDrive assets in this directory (ManualDriveController does not consume
  LongitudinalAction for a domain it owns).

  Requires OSI capture (batch osi:true) for parity with the rest of the batch;
  brake_not_stacked itself reads HVD.
-->
<OpenSCENARIO>
   <FileHeader revMajor="1" revMinor="3" date="2026-08-04T00:00:00"
               description="ManualDrive ADAS verification: driver already braking at/above AEB's own request, cut-in + hard brake" author="GT_esmini"/>
   <ParameterDeclarations>
      <ParameterDeclaration name="EgoSpeed"   parameterType="double" value="30.0"/>  <!-- 108 km/h -->
      <ParameterDeclaration name="LeadSpeed"  parameterType="double" value="12.0"/>  <!-- ~43 km/h -->
      <ParameterDeclaration name="LeadStartS" parameterType="double" value="78.0"/>  <!-- ~48 m gap; ego closes at ~18 m/s -->
      <ParameterDeclaration name="CutInTime"  parameterType="double" value="1.6"/>
      <ParameterDeclaration name="CutInDur"   parameterType="double" value="1.4"/>  <!-- slow cut-in = late same-lane detection -->
      <ParameterDeclaration name="BrakeTime"  parameterType="double" value="2.4"/>
      <ParameterDeclaration name="BrakeRate"  parameterType="double" value="8.0"/>
      <ParameterDeclaration name="BrakeTarget" parameterType="double" value="0.0"/>
   </ParameterDeclarations>
   <CatalogLocations/>
   <RoadNetwork>
      <LogicFile filepath="../../../xodr/straight_500m_2lane.xodr"/>
   </RoadNetwork>
   <Entities>
      <ScenarioObject name="Ego">
         <Vehicle name="car_white" vehicleCategory="car" model3d="../../../models/car_white.osgb">
            <BoundingBox>
               <Center x="1.4" y="0.0" z="0.9"/>
               <Dimensions width="2.0" length="5.0" height="1.8"/>
            </BoundingBox>
            <Performance maxSpeed="69" maxDeceleration="30" maxAcceleration="10"/>
            <Axles>
               <FrontAxle maxSteering="30" wheelDiameter="0.8" trackWidth="1.68" positionX="2.98" positionZ="0.4"/>
               <RearAxle maxSteering="30" wheelDiameter="0.8" trackWidth="1.68" positionX="0" positionZ="0.4"/>
            </Axles>
            <Properties>
               <Property name="model_id" value="0"/>
               <Property name="scaleMode" value="ModelToBB"/>
            </Properties>
         </Vehicle>
         <ObjectController>
            <Controller name="ManualDriveController">
               <Properties>
                  <Property name="esminiController" value="ManualDriveController"/>
                  <Property name="ConfigFile" value="manual_drive_headless_stub.json"/>
               </Properties>
            </Controller>
         </ObjectController>
      </ScenarioObject>
      <ScenarioObject name="Lead">
         <Vehicle name="car_red" vehicleCategory="car" model3d="../../../models/car_red.osgb">
            <BoundingBox>
               <Center x="1.4" y="0.0" z="0.9"/>
               <Dimensions width="2.0" length="5.0" height="1.8"/>
            </BoundingBox>
            <Performance maxSpeed="69" maxDeceleration="30" maxAcceleration="10"/>
            <Axles>
               <FrontAxle maxSteering="30" wheelDiameter="0.8" trackWidth="1.68" positionX="2.98" positionZ="0.4"/>
               <RearAxle maxSteering="30" wheelDiameter="0.8" trackWidth="1.68" positionX="0" positionZ="0.4"/>
            </Axles>
            <Properties>
               <Property name="model_id" value="1"/>
               <Property name="scaleMode" value="ModelToBB"/>
            </Properties>
         </Vehicle>
      </ScenarioObject>
   </Entities>
   <Storyboard>
      <Init>
         <Actions>
            <Private entityRef="Ego">
               <PrivateAction>
                  <TeleportAction>
                     <Position><LanePosition roadId="1" laneId="-1" offset="0" s="30"/></Position>
                  </TeleportAction>
               </PrivateAction>
               <PrivateAction>
                  <LongitudinalAction>
                     <SpeedAction>
                        <SpeedActionDynamics dynamicsShape="step" value="0" dynamicsDimension="time"/>
                        <SpeedActionTarget><AbsoluteTargetSpeed value="$EgoSpeed"/></SpeedActionTarget>
                     </SpeedAction>
                  </LongitudinalAction>
               </PrivateAction>
               <PrivateAction>
                  <ControllerAction>
                     <ActivateControllerAction objectControllerRef="ManualDriveController" lateral="true" longitudinal="true"/>
                  </ControllerAction>
               </PrivateAction>
            </Private>
            <Private entityRef="Lead">
               <PrivateAction>
                  <TeleportAction>
                     <Position><LanePosition roadId="1" laneId="-2" offset="0" s="$LeadStartS"/></Position>
                  </TeleportAction>
               </PrivateAction>
               <PrivateAction>
                  <LongitudinalAction>
                     <SpeedAction>
                        <SpeedActionDynamics dynamicsShape="step" value="0" dynamicsDimension="time"/>
                        <SpeedActionTarget><AbsoluteTargetSpeed value="$LeadSpeed"/></SpeedActionTarget>
                     </SpeedAction>
                  </LongitudinalAction>
               </PrivateAction>
            </Private>
         </Actions>
      </Init>
      <Story name="CutInBrakeStory">
         <Act name="CutInBrakeAct">
            <ManeuverGroup maximumExecutionCount="1" name="EgoSequence">
               <Actors selectTriggeringEntities="false"><EntityRef entityRef="Ego"/></Actors>
            </ManeuverGroup>
            <ManeuverGroup maximumExecutionCount="1" name="LeadSequence">
               <Actors selectTriggeringEntities="false"><EntityRef entityRef="Lead"/></Actors>
               <Maneuver name="CutInManeuver">
                  <Event name="CutIn" priority="overwrite">
                     <Action name="CutInAction">
                        <PrivateAction>
                           <LateralAction>
                              <LaneChangeAction>
                                 <LaneChangeActionDynamics dynamicsShape="sinusoidal" value="$CutInDur" dynamicsDimension="time"/>
                                 <LaneChangeTarget><RelativeTargetLane entityRef="Ego" value="0"/></LaneChangeTarget>
                              </LaneChangeAction>
                           </LateralAction>
                        </PrivateAction>
                     </Action>
                     <StartTrigger>
                        <ConditionGroup>
                           <Condition name="CutInTrigger" delay="0" conditionEdge="none">
                              <ByValueCondition><SimulationTimeCondition value="$CutInTime" rule="greaterThan"/></ByValueCondition>
                           </Condition>
                        </ConditionGroup>
                     </StartTrigger>
                  </Event>
               </Maneuver>
               <Maneuver name="LeadBrakeManeuver">
                  <Event name="LeadBrake" priority="overwrite">
                     <Action name="LeadBrakeAction">
                        <PrivateAction>
                           <LongitudinalAction>
                              <SpeedAction>
                                 <SpeedActionDynamics dynamicsShape="linear" value="$BrakeRate" dynamicsDimension="rate"/>
                                 <SpeedActionTarget><AbsoluteTargetSpeed value="$BrakeTarget"/></SpeedActionTarget>
                              </SpeedAction>
                           </LongitudinalAction>
                        </PrivateAction>
                     </Action>
                     <StartTrigger>
                        <ConditionGroup>
                           <Condition name="BrakeTrigger" delay="0" conditionEdge="none">
                              <ByValueCondition><SimulationTimeCondition value="$BrakeTime" rule="greaterThan"/></ByValueCondition>
                           </Condition>
                        </ConditionGroup>
                     </StartTrigger>
                  </Event>
               </Maneuver>
            </ManeuverGroup>
            <StartTrigger>
               <ConditionGroup>
                  <Condition name="ActStart" delay="0" conditionEdge="none">
                     <ByValueCondition><SimulationTimeCondition value="0" rule="greaterThan"/></ByValueCondition>
                  </Condition>
               </ConditionGroup>
            </StartTrigger>
         </Act>
      </Story>
      <StopTrigger>
         <ConditionGroup>
            <Condition name="StopCondition" delay="0" conditionEdge="rising">
               <ByValueCondition><SimulationTimeCondition value="20" rule="greaterThan"/></ByValueCondition>
            </Condition>
         </ConditionGroup>
      </StopTrigger>
   </Storyboard>
</OpenSCENARIO>

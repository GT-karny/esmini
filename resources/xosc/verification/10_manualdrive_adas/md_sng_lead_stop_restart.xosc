<?xml version="1.0" encoding="UTF-8"?>
<!--
  ManualDrive ADAS verification scenario 10_manualdrive_adas / md_sng_lead_stop_restart
  (req-vd-ad:REQ-AD-031 step a, vd-func:FUNC-079; slugs md-sng-stop-hold-no-creep and
  md-sng-restart-on-accel). Added 2026-08-05 (phase C).

  Ego engages ACC at 16 m/s behind a lead 55 m ahead at the same speed; from t=4 the
  lead brakes to a standstill over ~6.5 s and stays there. ACC follows it to v=0 and
  must then HOLD - and the hold is the part that needs a real vehicle to test,
  because RealVehicle models an automatic transmission and CREEPS: releasing the
  brake at a standstill moves the car (design §12). A stop-and-go implementation that
  merely stops commanding acceleration would look correct in every unit test and
  would roll into the lead here.

  The driver's accelerator pulse at t=21 (acc_ops_stop_restart.json) is the ONLY
  restart trigger. The lead remains stationary for the whole rest of the run, which
  makes the pulse the only available explanation for any subsequent movement - if
  the lead pulled away and the ego followed, "it restarted" would be true of a
  function that restarts by itself, which 段a explicitly forbids (段c/d are future
  work).

  Timing: the lead is stopped by ~t=10.5 and the ego shortly after, giving ~5 s of
  standing hold before the pulse - long enough for creep to travel a visible
  distance at any plausible creep torque, and short enough to leave the restart with
  room inside the 30 s run. The pulse time is MEASURED: the first probe run put it at
  t=16 and the car was still rolling at 1.2 m/s then, so the scenario was measuring an
  accelerator override rather than a Stop-and-Go release (see
  GT_esmini/docs/virtualdriver/measurements/manualdrive_creep_stop_hold_2026-08-05.md).
-->
<OpenSCENARIO>
   <FileHeader revMajor="1" revMinor="3" date="2026-08-05T00:00:00"
               description="ManualDrive ADAS verification: ACC Stop-and-Go follows a lead to a halt, holds, and restarts on the driver accelerator" author="GT_esmini"/>
   <ParameterDeclarations>
      <ParameterDeclaration name="EgoSpeed" parameterType="double" value="16.0"/>
   </ParameterDeclarations>
   <CatalogLocations/>
   <RoadNetwork>
      <LogicFile filepath="../../../xodr/straight_500m_2lane.xodr"/>
   </RoadNetwork>
   <Entities>
      <ScenarioObject name="Ego">
         <Vehicle name="car_white" vehicleCategory="car" model3d="../../../models/car_white.osgb">
            <BoundingBox>
               <Center x="1.4" y="0.0" z="0.9"/>
               <Dimensions width="2.0" length="5.0" height="1.8"/>
            </BoundingBox>
            <Performance maxSpeed="69" maxDeceleration="30" maxAcceleration="10"/>
            <Axles>
               <FrontAxle maxSteering="30" wheelDiameter="0.8" trackWidth="1.68" positionX="2.98" positionZ="0.4"/>
               <RearAxle maxSteering="30" wheelDiameter="0.8" trackWidth="1.68" positionX="0" positionZ="0.4"/>
            </Axles>
            <Properties>
               <Property name="model_id" value="0"/>
               <Property name="scaleMode" value="ModelToBB"/>
            </Properties>
         </Vehicle>
         <ObjectController>
            <Controller name="ManualDriveController">
               <Properties>
                  <Property name="esminiController" value="ManualDriveController"/>
                  <Property name="ConfigFile" value="manual_drive_headless_stub.json"/>
               </Properties>
            </Controller>
         </ObjectController>
      </ScenarioObject>
      <ScenarioObject name="Lead">
         <Vehicle name="car_red" vehicleCategory="car" model3d="../../../models/car_red.osgb">
            <BoundingBox>
               <Center x="1.4" y="0.0" z="0.9"/>
               <Dimensions width="2.0" length="5.0" height="1.8"/>
            </BoundingBox>
            <Performance maxSpeed="69" maxDeceleration="30" maxAcceleration="10"/>
            <Axles>
               <FrontAxle maxSteering="30" wheelDiameter="0.8" trackWidth="1.68" positionX="2.98" positionZ="0.4"/>
               <RearAxle maxSteering="30" wheelDiameter="0.8" trackWidth="1.68" positionX="0" positionZ="0.4"/>
            </Axles>
            <Properties>
               <Property name="model_id" value="1"/>
               <Property name="scaleMode" value="ModelToBB"/>
            </Properties>
         </Vehicle>
      </ScenarioObject>
   </Entities>
   <Storyboard>
      <Init>
         <Actions>
            <Private entityRef="Ego">
               <PrivateAction>
                  <TeleportAction>
                     <Position><LanePosition roadId="1" laneId="-1" offset="0" s="30"/></Position>
                  </TeleportAction>
               </PrivateAction>
               <PrivateAction>
                  <LongitudinalAction>
                     <SpeedAction>
                        <SpeedActionDynamics dynamicsShape="step" value="0" dynamicsDimension="time"/>
                        <SpeedActionTarget><AbsoluteTargetSpeed value="$EgoSpeed"/></SpeedActionTarget>
                     </SpeedAction>
                  </LongitudinalAction>
               </PrivateAction>
               <PrivateAction>
                  <ControllerAction>
                     <ActivateControllerAction objectControllerRef="ManualDriveController" lateral="true" longitudinal="true"/>
                  </ControllerAction>
               </PrivateAction>
            </Private>
            <Private entityRef="Lead">
               <PrivateAction>
                  <TeleportAction>
                     <Position><LanePosition roadId="1" laneId="-1" offset="0" s="85.0"/></Position>
                  </TeleportAction>
               </PrivateAction>
               <PrivateAction>
                  <LongitudinalAction>
                     <SpeedAction>
                        <SpeedActionDynamics dynamicsShape="step" value="0" dynamicsDimension="time"/>
                        <SpeedActionTarget><AbsoluteTargetSpeed value="16.0"/></SpeedActionTarget>
                     </SpeedAction>
                  </LongitudinalAction>
               </PrivateAction>
            </Private>
         </Actions>
      </Init>
      <Story name="StopAndGoStory">
         <Act name="StopAndGoAct">
            <ManeuverGroup maximumExecutionCount="1" name="EgoSequence">
               <Actors selectTriggeringEntities="false"><EntityRef entityRef="Ego"/></Actors>
            </ManeuverGroup>
            <StartTrigger>
               <ConditionGroup>
                  <Condition name="ActStart" delay="0" conditionEdge="none">
                     <ByValueCondition><SimulationTimeCondition value="0" rule="greaterThan"/></ByValueCondition>
                  </Condition>
               </ConditionGroup>
            </StartTrigger>
         </Act>
         <Act name="LeadAct">
            <ManeuverGroup maximumExecutionCount="1" name="LeadSequence">
               <Actors selectTriggeringEntities="false"><EntityRef entityRef="Lead"/></Actors>
               <Maneuver name="LeadSpeedChangeManeuver">
                  <Event name="LeadSpeedChangeEvent" priority="overwrite" maximumExecutionCount="1">
                     <Action name="LeadSpeedChangeAction">
                        <PrivateAction>
                           <LongitudinalAction>
                              <SpeedAction>
                                 <SpeedActionDynamics dynamicsShape="linear" value="2.5" dynamicsDimension="rate"/>
                                 <SpeedActionTarget><AbsoluteTargetSpeed value="0.0"/></SpeedActionTarget>
                              </SpeedAction>
                           </LongitudinalAction>
                        </PrivateAction>
                     </Action>
                     <StartTrigger>
                        <ConditionGroup>
                           <Condition name="LeadSpeedChangeTrigger" delay="0" conditionEdge="rising">
                              <ByValueCondition><SimulationTimeCondition value="4.0" rule="greaterThan"/></ByValueCondition>
                           </Condition>
                        </ConditionGroup>
                     </StartTrigger>
                  </Event>
               </Maneuver>
            </ManeuverGroup>
            <StartTrigger>
               <ConditionGroup>
                  <Condition name="LeadActStart" delay="0" conditionEdge="none">
                     <ByValueCondition><SimulationTimeCondition value="0" rule="greaterThan"/></ByValueCondition>
                  </Condition>
               </ConditionGroup>
            </StartTrigger>
         </Act>
      </Story>
      <StopTrigger>
         <ConditionGroup>
            <Condition name="StopCondition" delay="0" conditionEdge="rising">
               <ByValueCondition><SimulationTimeCondition value="30" rule="greaterThan"/></ByValueCondition>
            </Condition>
         </ConditionGroup>
      </StopTrigger>
   </Storyboard>
</OpenSCENARIO>

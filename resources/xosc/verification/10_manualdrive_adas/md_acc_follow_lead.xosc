<?xml version="1.0" encoding="UTF-8"?>
<!--
  ManualDrive ADAS verification scenario 10_manualdrive_adas / md_acc_follow_lead
  (req-vd-ad:REQ-AD-026 steps a and h, vd-func:FUNC-079; slugs md-acc-follow-thw-band
  and md-acc-thw-stage-runtime-change). Added 2026-08-05 (phase C).

  WHAT THE RUN IS. Ego starts at 24 m/s on a plain 500 m two-lane straight with a
  Lead 60 m ahead cruising at 15 m/s. The driver switches ACC on and SETs at t=1.0
  (acc_ops_setting_changes profile) and then never touches a pedal again: every
  deceleration, every gap the run produces after that instant is the FUNCTION's.
  Because the set speed (24, adopted from the current speed at SET) is well above
  the lead's 15, the set-speed term is never the binding one - the gap term is,
  which is what makes this a FOLLOWING test rather than a cruise test that happens
  to have a car in front.

  WHY THE SAME RUN CARRIES step h. The profile cycles the following-distance stage
  twice, at t=12 and t=17, long after the follow has settled. Step h asks for a
  single stimulus that crosses two or more stages precisely because one change
  cannot tell a real selector from a field that flips once; two changes in opposite
  directions (mid -> long -> short) also mean the measured headway has to move BOTH
  ways, which a controller that merely reported the setting back to itself could not
  do.

  THE SETTLE TIME IS NOT DECORATIVE. The stage changes are placed 5 s apart and 10 s
  after the follow begins because the IDM gap term converges over seconds, not
  frames: a stage change sampled before the previous one had settled would be
  measured against a moving baseline, and the resulting "the headway changed" would
  be true of a run that was still converging from the last change.

  Speeds chosen so the whole encounter fits inside 500 m at 24 m/s with the lead
  ahead throughout: closing 9 m/s over 60 m takes ~7 s to reach the gap term, and
  the run ends at 25 s with the ego around s=380.

  Ego's ManeuverGroup carries no scripted longitudinal action (ManualDriveController
  does not consume LongitudinalAction for a domain it owns).
-->
<OpenSCENARIO>
   <FileHeader revMajor="1" revMinor="3" date="2026-08-05T00:00:00"
               description="ManualDrive ADAS verification: ACC follows a slower lead, following-distance stage changed twice mid-run" author="GT_esmini"/>
   <ParameterDeclarations>
      <ParameterDeclaration name="EgoSpeed"   parameterType="double" value="24.0"/>
      <ParameterDeclaration name="LeadSpeed"  parameterType="double" value="15.0"/>
      <ParameterDeclaration name="LeadStartS" parameterType="double" value="90.0"/>  <!-- Ego at s=30 -> initial gap ~60 m -->
   </ParameterDeclarations>
   <CatalogLocations/>
   <RoadNetwork>
      <LogicFile filepath="../../../xodr/straight_500m_2lane.xodr"/>
   </RoadNetwork>
   <Entities>
      <ScenarioObject name="Ego">
         <Vehicle name="car_white" vehicleCategory="car" model3d="../../../models/car_white.osgb">
            <BoundingBox>
               <Center x="1.4" y="0.0" z="0.9"/>
               <Dimensions width="2.0" length="5.0" height="1.8"/>
            </BoundingBox>
            <Performance maxSpeed="69" maxDeceleration="30" maxAcceleration="10"/>
            <Axles>
               <FrontAxle maxSteering="30" wheelDiameter="0.8" trackWidth="1.68" positionX="2.98" positionZ="0.4"/>
               <RearAxle maxSteering="30" wheelDiameter="0.8" trackWidth="1.68" positionX="0" positionZ="0.4"/>
            </Axles>
            <Properties>
               <Property name="model_id" value="0"/>
               <Property name="scaleMode" value="ModelToBB"/>
            </Properties>
         </Vehicle>
         <ObjectController>
            <Controller name="ManualDriveController">
               <Properties>
                  <Property name="esminiController" value="ManualDriveController"/>
                  <Property name="ConfigFile" value="manual_drive_headless_stub.json"/>
               </Properties>
            </Controller>
         </ObjectController>
      </ScenarioObject>
      <ScenarioObject name="Lead">
         <Vehicle name="car_red" vehicleCategory="car" model3d="../../../models/car_red.osgb">
            <BoundingBox>
               <Center x="1.4" y="0.0" z="0.9"/>
               <Dimensions width="2.0" length="5.0" height="1.8"/>
            </BoundingBox>
            <Performance maxSpeed="69" maxDeceleration="30" maxAcceleration="10"/>
            <Axles>
               <FrontAxle maxSteering="30" wheelDiameter="0.8" trackWidth="1.68" positionX="2.98" positionZ="0.4"/>
               <RearAxle maxSteering="30" wheelDiameter="0.8" trackWidth="1.68" positionX="0" positionZ="0.4"/>
            </Axles>
            <Properties>
               <Property name="model_id" value="1"/>
               <Property name="scaleMode" value="ModelToBB"/>
            </Properties>
         </Vehicle>
      </ScenarioObject>
   </Entities>
   <Storyboard>
      <Init>
         <Actions>
            <Private entityRef="Ego">
               <PrivateAction>
                  <TeleportAction>
                     <Position><LanePosition roadId="1" laneId="-1" offset="0" s="30"/></Position>
                  </TeleportAction>
               </PrivateAction>
               <PrivateAction>
                  <LongitudinalAction>
                     <SpeedAction>
                        <SpeedActionDynamics dynamicsShape="step" value="0" dynamicsDimension="time"/>
                        <SpeedActionTarget><AbsoluteTargetSpeed value="$EgoSpeed"/></SpeedActionTarget>
                     </SpeedAction>
                  </LongitudinalAction>
               </PrivateAction>
               <PrivateAction>
                  <ControllerAction>
                     <ActivateControllerAction objectControllerRef="ManualDriveController" lateral="true" longitudinal="true"/>
                  </ControllerAction>
               </PrivateAction>
            </Private>
            <Private entityRef="Lead">
               <PrivateAction>
                  <TeleportAction>
                     <Position><LanePosition roadId="1" laneId="-1" offset="0" s="$LeadStartS"/></Position>
                  </TeleportAction>
               </PrivateAction>
               <PrivateAction>
                  <LongitudinalAction>
                     <SpeedAction>
                        <SpeedActionDynamics dynamicsShape="step" value="0" dynamicsDimension="time"/>
                        <SpeedActionTarget><AbsoluteTargetSpeed value="$LeadSpeed"/></SpeedActionTarget>
                     </SpeedAction>
                  </LongitudinalAction>
               </PrivateAction>
            </Private>
         </Actions>
      </Init>
      <Story name="AccFollowStory">
         <Act name="AccFollowAct">
            <ManeuverGroup maximumExecutionCount="1" name="EgoSequence">
               <Actors selectTriggeringEntities="false"><EntityRef entityRef="Ego"/></Actors>
            </ManeuverGroup>
            <StartTrigger>
               <ConditionGroup>
                  <Condition name="ActStart" delay="0" conditionEdge="none">
                     <ByValueCondition><SimulationTimeCondition value="0" rule="greaterThan"/></ByValueCondition>
                  </Condition>
               </ConditionGroup>
            </StartTrigger>
         </Act>
      </Story>
      <StopTrigger>
         <ConditionGroup>
            <Condition name="StopCondition" delay="0" conditionEdge="rising">
               <ByValueCondition><SimulationTimeCondition value="25" rule="greaterThan"/></ByValueCondition>
            </Condition>
         </ConditionGroup>
      </StopTrigger>
   </Storyboard>
</OpenSCENARIO>

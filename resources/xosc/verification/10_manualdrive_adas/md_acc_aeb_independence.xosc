<?xml version="1.0" encoding="UTF-8"?>
<!--
  ManualDrive ADAS verification scenario 10_manualdrive_adas / md_acc_aeb_independence
  (req-vd-ad:REQ-AD-026 step d, vd-func:FUNC-079 + FUNC-075; slug
  md-acc-aeb-independence). Added 2026-08-05 (phase C).

  ACC engaged and following 35 m behind, and then the lead brakes far harder than a
  comfort-tier following controller can answer (to 0 at 8 m/s^2 from t=4). ACC's own
  deceleration budget is adas_acc_decel_max_mps2 = 2.0 m/s^2, which needs 121 m to
  shed 22 m/s; the lead leaves it about 65 m. The gap therefore collapses faster than
  the generate stage can hold it, AEB fires, and the SAFETY stage - which runs last,
  after generate and limit (design §3-1) - raises the brake beyond whatever ACC had
  asked for.

  THE 35 m GAP IS MEASURED, NOT CHOSEN FOR DRAMA. The first version of this scenario
  put the lead 60 m ahead and braked at t=6: ACC absorbed the whole event on its own
  and gt.aeb never left STANDBY for the entire run, so the scenario claimed an
  independence it never exercised. A run in which the safety layer is never reached
  cannot evidence that safety wins.

  WHAT MAKES THIS A TEST OF INDEPENDENCE RATHER THAN OF BRAKING. Both functions are
  reacting to the same physical lead, so "the car braked" proves nothing about which
  one did it. The separable evidence is that gt.acc stays ACTIVE (it was never
  cancelled, never demoted - the driver did nothing) while gt.aeb ALSO goes ACTIVE,
  and the effective brake exceeds ACC's own gt.acc.brake_out. Two functions in
  ACTIVE at once, with the safety one setting the outcome, is exactly the tier
  arbitration step d claims for the manual-driving case.

  This is also why EvaluateAccCeiling excludes SAFETY-tier constraints
  (AccLonController.hpp): if ACC folded AEB's stop demand into its own ceiling, the
  two would be reacting to one constraint and this scenario could not tell them
  apart.
-->
<OpenSCENARIO>
   <FileHeader revMajor="1" revMinor="3" date="2026-08-05T00:00:00"
               description="ManualDrive ADAS verification: AEB fires independently while ACC is active, and safety wins" author="GT_esmini"/>
   <ParameterDeclarations>
      <ParameterDeclaration name="EgoSpeed" parameterType="double" value="22.0"/>
   </ParameterDeclarations>
   <CatalogLocations/>
   <RoadNetwork>
      <LogicFile filepath="../../../xodr/straight_500m_2lane.xodr"/>
   </RoadNetwork>
   <Entities>
      <ScenarioObject name="Ego">
         <Vehicle name="car_white" vehicleCategory="car" model3d="../../../models/car_white.osgb">
            <BoundingBox>
               <Center x="1.4" y="0.0" z="0.9"/>
               <Dimensions width="2.0" length="5.0" height="1.8"/>
            </BoundingBox>
            <Performance maxSpeed="69" maxDeceleration="30" maxAcceleration="10"/>
            <Axles>
               <FrontAxle maxSteering="30" wheelDiameter="0.8" trackWidth="1.68" positionX="2.98" positionZ="0.4"/>
               <RearAxle maxSteering="30" wheelDiameter="0.8" trackWidth="1.68" positionX="0" positionZ="0.4"/>
            </Axles>
            <Properties>
               <Property name="model_id" value="0"/>
               <Property name="scaleMode" value="ModelToBB"/>
            </Properties>
         </Vehicle>
         <ObjectController>
            <Controller name="ManualDriveController">
               <Properties>
                  <Property name="esminiController" value="ManualDriveController"/>
                  <Property name="ConfigFile" value="manual_drive_headless_stub.json"/>
               </Properties>
            </Controller>
         </ObjectController>
      </ScenarioObject>
      <ScenarioObject name="Lead">
         <Vehicle name="car_red" vehicleCategory="car" model3d="../../../models/car_red.osgb">
            <BoundingBox>
               <Center x="1.4" y="0.0" z="0.9"/>
               <Dimensions width="2.0" length="5.0" height="1.8"/>
            </BoundingBox>
            <Performance maxSpeed="69" maxDeceleration="30" maxAcceleration="10"/>
            <Axles>
               <FrontAxle maxSteering="30" wheelDiameter="0.8" trackWidth="1.68" positionX="2.98" positionZ="0.4"/>
               <RearAxle maxSteering="30" wheelDiameter="0.8" trackWidth="1.68" positionX="0" positionZ="0.4"/>
            </Axles>
            <Properties>
               <Property name="model_id" value="1"/>
               <Property name="scaleMode" value="ModelToBB"/>
            </Properties>
         </Vehicle>
      </ScenarioObject>
   </Entities>
   <Storyboard>
      <Init>
         <Actions>
            <Private entityRef="Ego">
               <PrivateAction>
                  <TeleportAction>
                     <Position><LanePosition roadId="1" laneId="-1" offset="0" s="30"/></Position>
                  </TeleportAction>
               </PrivateAction>
               <PrivateAction>
                  <LongitudinalAction>
                     <SpeedAction>
                        <SpeedActionDynamics dynamicsShape="step" value="0" dynamicsDimension="time"/>
                        <SpeedActionTarget><AbsoluteTargetSpeed value="$EgoSpeed"/></SpeedActionTarget>
                     </SpeedAction>
                  </LongitudinalAction>
               </PrivateAction>
               <PrivateAction>
                  <ControllerAction>
                     <ActivateControllerAction objectControllerRef="ManualDriveController" lateral="true" longitudinal="true"/>
                  </ControllerAction>
               </PrivateAction>
            </Private>
            <Private entityRef="Lead">
               <PrivateAction>
                  <TeleportAction>
                     <Position><LanePosition roadId="1" laneId="-1" offset="0" s="65.0"/></Position>
                  </TeleportAction>
               </PrivateAction>
               <PrivateAction>
                  <LongitudinalAction>
                     <SpeedAction>
                        <SpeedActionDynamics dynamicsShape="step" value="0" dynamicsDimension="time"/>
                        <SpeedActionTarget><AbsoluteTargetSpeed value="22.0"/></SpeedActionTarget>
                     </SpeedAction>
                  </LongitudinalAction>
               </PrivateAction>
            </Private>
         </Actions>
      </Init>
      <Story name="AccAebIndependenceStory">
         <Act name="AccAebIndependenceAct">
            <ManeuverGroup maximumExecutionCount="1" name="EgoSequence">
               <Actors selectTriggeringEntities="false"><EntityRef entityRef="Ego"/></Actors>
            </ManeuverGroup>
            <StartTrigger>
               <ConditionGroup>
                  <Condition name="ActStart" delay="0" conditionEdge="none">
                     <ByValueCondition><SimulationTimeCondition value="0" rule="greaterThan"/></ByValueCondition>
                  </Condition>
               </ConditionGroup>
            </StartTrigger>
         </Act>
         <Act name="LeadAct">
            <ManeuverGroup maximumExecutionCount="1" name="LeadSequence">
               <Actors selectTriggeringEntities="false"><EntityRef entityRef="Lead"/></Actors>
               <Maneuver name="LeadSpeedChangeManeuver">
                  <Event name="LeadSpeedChangeEvent" priority="overwrite" maximumExecutionCount="1">
                     <Action name="LeadSpeedChangeAction">
                        <PrivateAction>
                           <LongitudinalAction>
                              <SpeedAction>
                                 <SpeedActionDynamics dynamicsShape="linear" value="8.0" dynamicsDimension="rate"/>
                                 <SpeedActionTarget><AbsoluteTargetSpeed value="0.0"/></SpeedActionTarget>
                              </SpeedAction>
                           </LongitudinalAction>
                        </PrivateAction>
                     </Action>
                     <StartTrigger>
                        <ConditionGroup>
                           <Condition name="LeadSpeedChangeTrigger" delay="0" conditionEdge="rising">
                              <ByValueCondition><SimulationTimeCondition value="4.0" rule="greaterThan"/></ByValueCondition>
                           </Condition>
                        </ConditionGroup>
                     </StartTrigger>
                  </Event>
               </Maneuver>
            </ManeuverGroup>
            <StartTrigger>
               <ConditionGroup>
                  <Condition name="LeadActStart" delay="0" conditionEdge="none">
                     <ByValueCondition><SimulationTimeCondition value="0" rule="greaterThan"/></ByValueCondition>
                  </Condition>
               </ConditionGroup>
            </StartTrigger>
         </Act>
      </Story>
      <StopTrigger>
         <ConditionGroup>
            <Condition name="StopCondition" delay="0" conditionEdge="rising">
               <ByValueCondition><SimulationTimeCondition value="20" rule="greaterThan"/></ByValueCondition>
            </Condition>
         </ConditionGroup>
      </StopTrigger>
   </Storyboard>
</OpenSCENARIO>

        </ScenarioObject>
        <ScenarioObject name="Lead">
            <Vehicle name="car_red" vehicleCategory="car">
                <BoundingBox>
                    <Center x="1.4" y="0.0" z="0.9"/>
                    <Dimensions width="2.0" length="5.0" height="1.8"/>
                </BoundingBox>
                <Performance maxSpeed="69.0" maxDeceleration="30.0" maxAcceleration="10.0"/>
                <Axles>
                    <FrontAxle maxSteering="0.52" wheelDiameter="0.8" trackWidth="1.68" positionX="2.98" positionZ="0.4"/>
                    <RearAxle maxSteering="0.0" wheelDiameter="0.8" trackWidth="1.68" positionX="0.0" positionZ="0.4"/>

<?xml version="1.0" encoding="UTF-8"?>
<!--
  VirtualDriver verification scenario 03_traffic_signals / red_hold_stop_line_paired_farside
  Far-side discriminator for the stop-line-anchor redesign (design/
  stop_line_stop_target.md), TrafficLightAware side. Added 2026-08-02 alongside
  the redesign of red_hold_stop_line_paired.xosc (see that file's own comment
  for the head-anchor to junction-entry-anchor background). Wired into
  stop_line_pairing_batch.yaml and the regression baseline (GT_esmini/test/
  regression_baseline/stop_line_pairing_expected.yaml) as of the
  min(entry, head) anchor fix (see TrafficLightAware.hpp/RouteSignalScan.hpp's
  ResolveStopLineAnchor): this scenario is the one the whole anchor redesign
  exists for, so it belongs in the gate that protects it. Also runnable
  standalone (gt_sim_test.py run / assert both work against it directly).

  This is the configuration the junction-entry anchor exists FOR: a head
  mounted on the FAR side of the junction it governs (a mast-arm/far-side
  signal), where the OLD head-anchor design could never pair correctly. The
  stop line, on the near approach road, is always FARTHER from a far-side head
  than tl_stop_line_window can reach, no matter how the window is tuned; it is
  on the wrong side of the junction entirely. The junction-entry anchor CAN
  pair it, because it measures from a point (the entry) that is on the SAME
  side of the junction as the stop line.

  Road signalized_short_block__b12_sl8_fsa1 (resources/scenario_authoring/
  road_catalog, gen_signalized_short_block.py, stop-line-setback-a=8,
  head-farside-offset-a=1.0): road 0 carries ONLY a paired stop-line signal
  (id=2, type=294, country=OpenDRIVE, s=92, 8 m before junction A's entry at
  s=100); no head on road 0 at all. The head governing junction A (id=0,
  "light_junction_a_farside") sits on road 2 (the short block PAST junction
  A's exit), s=1.0, wired to junction A through an OpenDRIVE controller
  (SignalJunctionResolver path (a)) because its own road-link geometry (path
  (c), road 2's successor link) resolves to junction B instead. Signal id=1
  (light_junction_b, road 2 s=3.0) exists in the shared road-generator asset
  and is set GREEN for the whole run so it never contributes a stop of its own
  and stays clearly non-governing (the far-side head at s=1.0 is nearer, so it
  governs regardless, but an explicit green removes any doubt).

  Two arms (see expectations.yaml notes for the measured numbers):
    ON  (tl_stop_line_aware_enabled=true, the committed default): the
        junction-A head resolves to junction A's entry (present on this
        route's spans); FindPairedStopLineByDistance pairs the stop line at
        s=92 (8 m before the entry, well inside the 10 m window). Expect
        gt.traffic_light.stop_line_anchor="junction_entry",
        stop_line_used=true, and a stop near the stop line.
    OFF (tl_stop_line_aware_enabled=false, NOT reachable through the default
        config; run standalone with a ConfigFile override, same idiom as
        red_hold_stop_line_paired.expectations.yaml's own OFF arm): no pairing
        is attempted at all; the raw distance to the far-side head is used,
        which is past junction A's exit, a target JunctionStopGuard must
        classify as blocking junction A and PULL_BACK to before its entry
        (the same "don't block the box" mechanism junction_not_blocked.xosc
        exercises). Expect gt.traffic_light.stop_line_anchor="head",
        stop_line_used=false, gt.traffic_light.junction_action="pull_back",
        and a stop several metres CLOSER to the junction than the ON arm's
        stop line (the ego does stop, for a real reason, the guard, just in
        the wrong place relative to the marked stop line).

  Ego kinematics (start s=10 on road 0, EgoSpeed=10.0, 3 s linear ramp,
  StopTrigger at t=35) deliberately mirror junction_not_blocked.xosc's own
  proven PULL_BACK-not-SUPPRESS timing (same leg_length=100, same
  tl_junction_guard_enabled defaults) rather than this directory's other
  stop-line scenarios, which use a faster EgoSpeed and do not need to survive
  a guard braking-feasibility check on the OFF arm.
-->
<OpenSCENARIO>
   <FileHeader revMajor="1"
               revMinor="1"
               date="2026-08-02T10:00:00"
               description="VirtualDriver verification: far-side head (governs junction A via controller, physically past it) pairs to the stop line only once the anchor is the junction entry"
               author="GT_esmini"/>
   <ParameterDeclarations>
      <ParameterDeclaration name="EgoSpeed" parameterType="double" value="10.0"/>
   </ParameterDeclarations>
   <CatalogLocations/>
   <RoadNetwork>
      <LogicFile filepath="../../../scenario_authoring/road_catalog/generated/signalized_short_block__b12_sl8_fsa1.xodr"/>
      <TrafficSignals>
         <TrafficSignalController name="MainController" delay="0">
            <Phase name="red" duration="60">
               <TrafficSignalState trafficSignalId="0" state="on;off;off"/>
               <TrafficSignalState trafficSignalId="1" state="off;off;on"/>
            </Phase>
         </TrafficSignalController>
      </TrafficSignals>
   </RoadNetwork>
   <Entities>
      <ScenarioObject name="Ego">
         <Vehicle name="car_white" vehicleCategory="car" model3d="../../../models/car_white.osgb">
            <BoundingBox>
               <Center x="1.4" y="0.0" z="0.9"/>
               <Dimensions width="2.0" length="5.0" height="1.8"/>
            </BoundingBox>
            <Performance maxSpeed="69" maxDeceleration="30" maxAcceleration="10"/>
            <Axles>
               <FrontAxle maxSteering="30" wheelDiameter="0.8" trackWidth="1.68" positionX="2.98" positionZ="0.4"/>
               <RearAxle maxSteering="30" wheelDiameter="0.8" trackWidth="1.68" positionX="0" positionZ="0.4"/>
            </Axles>
            <Properties>
               <Property name="model_id" value="0"/>
               <Property name="scaleMode" value="ModelToBB"/>
            </Properties>
         </Vehicle>
         <ObjectController>
            <Controller name="VirtualDriverController">
               <Properties>
                  <Property name="esminiController" value="VirtualDriverController"/>
               </Properties>
            </Controller>
         </ObjectController>
      </ScenarioObject>
   </Entities>
   <Storyboard>
      <Init>
         <Actions>
            <Private entityRef="Ego">
               <PrivateAction>
                  <TeleportAction>
                     <Position>
                        <LanePosition roadId="0" laneId="-1" offset="0" s="10"/>
                     </Position>
                  </TeleportAction>
               </PrivateAction>
               <PrivateAction>
                  <RoutingAction>
                     <AssignRouteAction>
                        <Route name="ego_route" closed="false">
                           <Waypoint routeStrategy="shortest">
                              <Position>
                                 <LanePosition roadId="0" laneId="-1" offset="0" s="10"/>
                              </Position>
                           </Waypoint>
                           <Waypoint routeStrategy="shortest">
                              <Position>
                                 <LanePosition roadId="100" laneId="-1" offset="0" s="8.0"/>
                              </Position>
                           </Waypoint>
                           <Waypoint routeStrategy="shortest">
                              <Position>
                                 <LanePosition roadId="2" laneId="-1" offset="0" s="6"/>
                              </Position>
                           </Waypoint>
                        </Route>
                     </AssignRouteAction>
                  </RoutingAction>
               </PrivateAction>
               <PrivateAction>
                  <ControllerAction>
                     <ActivateControllerAction lateral="true" longitudinal="true"/>
                  </ControllerAction>
               </PrivateAction>
            </Private>
         </Actions>
      </Init>
      <Story name="SignalStory">
         <Act name="SignalAct">
            <ManeuverGroup maximumExecutionCount="1" name="EgoSequence">
               <Actors selectTriggeringEntities="false">
                  <EntityRef entityRef="Ego"/>
               </Actors>
               <Maneuver name="CruiseManeuver">
                  <Event name="Cruise" priority="overwrite">
                     <Action name="CruiseAction">
                        <PrivateAction>
                           <LongitudinalAction>
                              <SpeedAction>
                                 <SpeedActionDynamics dynamicsShape="linear" value="3.0" dynamicsDimension="time"/>
                                 <SpeedActionTarget>
                                    <AbsoluteTargetSpeed value="$EgoSpeed"/>
                                 </SpeedActionTarget>
                              </SpeedAction>
                           </LongitudinalAction>
                        </PrivateAction>
                     </Action>
                     <StartTrigger>
                        <ConditionGroup>
                           <Condition name="CruiseStart" delay="0" conditionEdge="none">
                              <ByValueCondition>
                                 <SimulationTimeCondition value="0.0" rule="greaterThan"/>
                              </ByValueCondition>
                           </Condition>
                        </ConditionGroup>
                     </StartTrigger>
                  </Event>
               </Maneuver>
            </ManeuverGroup>
            <StartTrigger>
               <ConditionGroup>
                  <Condition name="ActStart" delay="0" conditionEdge="none">
                     <ByValueCondition>
                        <SimulationTimeCondition value="0" rule="greaterThan"/>
                     </ByValueCondition>
                  </Condition>
               </ConditionGroup>
            </StartTrigger>
         </Act>
      </Story>
      <StopTrigger>
         <ConditionGroup>
            <Condition name="StopCondition" delay="0" conditionEdge="rising">
               <ByValueCondition>
                  <SimulationTimeCondition value="35" rule="greaterThan"/>
               </ByValueCondition>
            </Condition>
         </ConditionGroup>
      </StopTrigger>
   </Storyboard>
</OpenSCENARIO>

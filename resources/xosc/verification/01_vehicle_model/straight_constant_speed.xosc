<?xml version="1.0" encoding="UTF-8"?>
<!--
  VirtualDriver verification scenario 01_vehicle_model / straight_constant_speed
  Simple deterministic baseline: single ego, straight road, constant 20 m/s.
  Used to verify vehicle-model longitudinal behaviour against the Default
  controller baseline. No traffic, no catalog, no target (path-robust).
-->
<OpenSCENARIO>
   <FileHeader revMajor="1"
               revMinor="1"
               date="2026-06-02T10:00:00"
               description="VirtualDriver verification: straight constant speed"
               author="GT_esmini"/>
   <ParameterDeclarations>
      <ParameterDeclaration name="EgoSpeed" parameterType="double" value="20"/>
   </ParameterDeclarations>
   <CatalogLocations/>
   <RoadNetwork>
      <LogicFile filepath="../../../xodr/straight_500m.xodr"/>
      <SceneGraphFile filepath="../../../models/straight_500m.osgb"/>
   </RoadNetwork>
   <Entities>
      <ScenarioObject name="Ego">
         <Vehicle name="car_white" vehicleCategory="car" model3d="../../../models/car_white.osgb">
            <BoundingBox>
               <Center x="1.4" y="0.0" z="0.9"/>
               <Dimensions width="2.0" length="5.0" height="1.8"/>
            </BoundingBox>
            <Performance maxSpeed="69" maxDeceleration="30" maxAcceleration="10"/>
            <Axles>
               <FrontAxle maxSteering="30" wheelDiameter="0.8" trackWidth="1.68" positionX="2.98" positionZ="0.4"/>
               <RearAxle maxSteering="30" wheelDiameter="0.8" trackWidth="1.68" positionX="0" positionZ="0.4"/>
            </Axles>
            <Properties>
               <Property name="model_id" value="0"/>
               <Property name="scaleMode" value="ModelToBB"/>
               <Property name="control" value="hybrid"/>
            </Properties>
         </Vehicle>
      </ScenarioObject>
   </Entities>
   <Storyboard>
      <Init>
         <Actions>
            <Private entityRef="Ego">
               <PrivateAction>
                  <TeleportAction>
                     <Position>
                        <LanePosition roadId="1" laneId="-1" offset="0" s="50"/>
                     </Position>
                  </TeleportAction>
               </PrivateAction>
               <PrivateAction>
                  <LongitudinalAction>
                     <SpeedAction>
                        <SpeedActionDynamics dynamicsShape="step" dynamicsDimension="time" value="0.0"/>
                        <SpeedActionTarget>
                           <AbsoluteTargetSpeed value="$EgoSpeed"/>
                        </SpeedActionTarget>
                     </SpeedAction>
                  </LongitudinalAction>
               </PrivateAction>
            </Private>
         </Actions>
      </Init>
      <Story name="MainStory">
         <Act name="MainAct">
            <ManeuverGroup maximumExecutionCount="1" name="EgoGroup">
               <Actors selectTriggeringEntities="false">
                  <EntityRef entityRef="Ego"/>
               </Actors>
            </ManeuverGroup>
            <StartTrigger>
               <ConditionGroup>
                  <Condition name="StartTrigger" delay="0" conditionEdge="none">
                     <ByValueCondition>
                        <SimulationTimeCondition value="0" rule="greaterThan"/>
                     </ByValueCondition>
                  </Condition>
               </ConditionGroup>
            </StartTrigger>
         </Act>
      </Story>
      <StopTrigger>
         <ConditionGroup>
            <Condition name="StopCondition" delay="0" conditionEdge="rising">
               <ByValueCondition>
                  <SimulationTimeCondition value="30" rule="greaterThan"/>
               </ByValueCondition>
            </Condition>
         </ConditionGroup>
      </StopTrigger>
   </Storyboard>
</OpenSCENARIO>
